# ClearPath Mapper (2143) — local/dev environment
# Copy to .env and fill in. Never commit the real .env.

# Railway Postgres plugin. Locally, use the plugin's PUBLIC connection string
# (Railway dashboard → Postgres → Connect → Public Network), or run commands
# through `railway run` and let Railway inject it.
DATABASE_URL=postgresql://user:password@host:port/railway

# Signs the session cookie. Any long random string; changing it logs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Magic-link delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ClearPath Mapper <login@clearpathmap.taxsherpa.com>

# Absolute base URL used to build the magic-link URL in the outbound email.
# Must match where the user's browser will actually land.
#   local:      http://localhost:2143
#   production: https://clearpathmap.taxsherpa.com
APP_URL=http://localhost:2143

# P&L PDF parsing (Gemini 2.5 Flash vision). Only PDF uploads need this;
# CSV uploads and sign-in work without it. GOOGLE_API_KEY also works.
# Key lives at G:\My Drive\_secure\gemini\gemini_api.txt (the GEMINI_API_KEY line).
GEMINI_API_KEY=

# Paid access gating. Off unless exactly "true": with it off, anyone can sign in, as before.
# With it on, only emails holding an active grant in `access_grants` can sign in or use the app.
# ACCESS_GATE_ENABLED=true

# Where the "no access" email and screen send people to buy. Optional.
# ACCESS_PURCHASE_URL=https://go.taxsherpa.com/hvac-workshop/register

# Shared secret GoHighLevel sends as the `x-api-key` header to POST /api/webhooks/ghl/access.
# Without it the webhook refuses every request. Generate like SESSION_SECRET.
GHL_ACCESS_WEBHOOK_SECRET=

# Optional. Defaults to 2143 (this project's code) locally; Railway injects its own.
# PORT=2143
